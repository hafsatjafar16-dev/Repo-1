# Copy to .env.local for development, and push each value to Vercel for
# production (see SETUP.md). Never commit the real .env.local file.

# --- Supabase (create a project at supabase.com, EU/Frankfurt region recommended) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini

# --- Auth gate ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=
DASHBOARD_PASSWORD=
# Generate with: openssl rand -hex 16
API_SECRET=

# --- Telegram capture bot (optional — skip if you'll only use the web capture box) ---
TELEGRAM_BOT_TOKEN=
# Generate with: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USER_ID=

# --- Misc ---
USER_TIMEZONE=Europe/London
USER_ID=default
